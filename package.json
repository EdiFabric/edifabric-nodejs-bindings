{
  "name": "edifabric-x12",
  "version": "1.1.1",
  "description": "Node.js bindings for ediFabric Native X12: convert X12 EDI to JSON and back, validate, and generate acknowledgments.",
  "main": "edifabric-x12.js",
  "types": "edifabric-x12.d.ts",
  "files": [
    "edifabric-x12.js",
    "edifabric-x12.d.ts",
    "c-abi-edifabric_x12_tools.h"
  ],
  "scripts": {
    "example": "node example_all_functions.js",
    "build-packages": "node scripts/build-packages.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "keywords": [
    "edifabric",
    "x12",
    "edi",
    "hipaa",
    "json",
    "ffi"
  ],
